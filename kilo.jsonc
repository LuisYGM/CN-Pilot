{
  "$schema": "https://app.kilo.ai/config.json",

  // No se fija proveedor/modelo para mantener el Blueprint portable.

  "permission": {
    "read": {
      ".env": "ask",
      ".env.*": "ask",
      "**/.env": "ask",
      "**/.env.*": "ask",
      "secrets/**": "deny",
      "*": "allow"
    },
    "edit": {
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "secrets/**": "deny",
      "*": "allow"
    },
    "bash": {
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "*": "ask"
    }
  },

  "watcher": {
    "ignore": ["tmp/**", "logs/**", ".cache/**"]
  }
}

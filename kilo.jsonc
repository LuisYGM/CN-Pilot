{
  "$schema": "https://app.kilo.ai/config.json",

  // No se fija proveedor/modelo para mantener el CN Pilot portable.

  "permission": {
    // Closed by default: new Kilo/MCP tools require an explicit per-tool decision.
    "*": "deny",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "**/.netrc": "deny",
      "**/.aws/credentials": "deny",
      "**/.docker/config.json": "deny",
      "**/credentials.json": "deny",
      "**/service-account.json": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_ecdsa": "deny",
      "**/id_dsa": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      ".kilocode/mcp.json": "deny",
      "**/.kilocode/mcp.json": "deny",
      ".kilo/mcp.json": "deny",
      "**/.kilo/mcp.json": "deny",
      "kilo.json": "ask",
      "kilo.jsonc": "ask",
      "**/kilo.json": "ask",
      "**/kilo.jsonc": "ask",
      ".kilo/kilo.json": "ask",
      ".kilo/kilo.jsonc": "ask",
      ".kilocode/kilo.json": "ask",
      ".kilocode/kilo.jsonc": "ask",
      ".npmrc": "ask",
      ".npmrc": "deny",
      "**/.npmrc": "deny",
      ".pypirc": "deny",
      "**/.pypirc": "deny",
      "**/*.key": "ask",
      "**/*.pem": "ask",
      "**/.kube/config": "ask",
      "**/kubeconfig": "ask",
      "secrets/**": "deny",
      "**/secrets/**": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "**/.netrc": "deny",
      "**/.aws/credentials": "deny",
      "**/.docker/config.json": "deny",
      "**/credentials.json": "deny",
      "**/service-account.json": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_ecdsa": "deny",
      "**/id_dsa": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      ".kilocode/mcp.json": "deny",
      "**/.kilocode/mcp.json": "deny",
      ".kilo/mcp.json": "deny",
      "**/.kilo/mcp.json": "deny",
      "kilo.json": "ask",
      "kilo.jsonc": "ask",
      "**/kilo.json": "ask",
      "**/kilo.jsonc": "ask",
      ".kilo/kilo.json": "ask",
      ".kilo/kilo.jsonc": "ask",
      ".kilocode/kilo.json": "ask",
      ".kilocode/kilo.jsonc": "ask",
      ".npmrc": "ask",
      ".npmrc": "deny",
      "**/.npmrc": "deny",
      ".pypirc": "deny",
      "**/.pypirc": "deny",
      "**/*.key": "ask",
      "**/*.pem": "ask",
      "**/.kube/config": "ask",
      "**/kubeconfig": "ask",
      "secrets/**": "deny",
      "**/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "board_read": "allow",
    "board_post": "allow",
    "agent_manager": "ask",
    "external_directory": "ask"
  },

  "watcher": {
    "ignore": ["tmp/**", "logs/**", ".cache/**"]
  }
}

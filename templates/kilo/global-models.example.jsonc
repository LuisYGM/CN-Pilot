{
  "$schema": "https://app.kilo.ai/config.json",

  // Template inactivo: integra estas claves en ~/.config/kilo/kilo.jsonc.
  // Sustituye los placeholders por IDs reales. No añadas credenciales aquí.
  "model": "PROVIDER/BALANCED_MODEL",
  "small_model": "PROVIDER/ECONOMICAL_MODEL",

  "agent": {
    "dev-lead": {
      "model": "PROVIDER/BALANCED_MODEL",
      "variant": "medium"
    },
    "architect": {
      "model": "PROVIDER/BALANCED_MODEL",
      "variant": "medium"
    },
    "reviewer": {
      "model": "PROVIDER/BALANCED_MODEL",
      "variant": "medium"
    },
    "developer": {
      "model": "PROVIDER/BALANCED_MODEL",
      "variant": "medium"
    },
    "ui-ux-designer": {
      "model": "PROVIDER/BALANCED_MODEL",
      "variant": "medium"
    },
    "frontend-builder": {
      "model": "PROVIDER/ECONOMICAL_MODEL",
      "variant": "medium"
    },
    "content-seo": {
      "model": "PROVIDER/ECONOMICAL_MODEL",
      "variant": "medium"
    },

    // Agentes internos/genéricos de Kilo.
    "general": {
      "model": "PROVIDER/ECONOMICAL_MODEL",
      "variant": "medium"
    },
    "explore": {
      "model": "PROVIDER/ECONOMICAL_MODEL",
      "variant": "medium"
    },
    "title": {
      "model": "PROVIDER/ECONOMICAL_MODEL"
    },
    "summary": {
      "model": "PROVIDER/ECONOMICAL_MODEL"
    },
    "compaction": {
      "model": "PROVIDER/ECONOMICAL_MODEL"
    }
  }
}
